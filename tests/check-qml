#!/usr/bin/env python3
"""Exercise the real QML request boundary against disposable stubs."""
import json,os,shutil,subprocess,tempfile
from pathlib import Path
source=Path(__file__).resolve().parents[1]
with tempfile.TemporaryDirectory(prefix='mint-qml-') as directory:
 root=Path(directory)
 for name in ('Request.qml','Model.js','Service.qml'): shutil.copyfile(source/name,root/name)
 (root/'bin').mkdir();runtime=root/'runtime';runtime.mkdir(mode=0o700)
 env=dict(os.environ,QT_QPA_PLATFORM='offscreen',QT_QPA_PLATFORMTHEME='',XDG_RUNTIME_DIR=str(runtime),MINT_OP='/usr/bin/false');env.pop('WAYLAND_DISPLAY',None);env.pop('DISPLAY',None)
 for mode in ('valid','invalid','oversized','stderr','cancel','service','demo','owner','busy-preview','uncertain-preview','demo-cycle'):
  script='import json,sys,time\nr=json.load(sys.stdin)\n'
  if mode=='invalid':script+='print("not-json")\n'
  elif mode=='oversized':script+='print("x"*70000)\n'
  elif mode=='stderr':script+='sys.stderr.write("x"*10000);time.sleep(.2)\n'
  elif mode=='cancel':script+='time.sleep(10)\n'
  elif mode=='demo':script+='raise Exception("Demo launched a subprocess")\n'
  else:script+='print(json.dumps({"ok":True,"data":[{"name":"pin6"}]} if r.get("operation")=="presets" else {"ok":True,"data":{"password":"fixture-only","length":12,"entropy_bits":32,"rule":{"summary":"fixture"}}}))\n'
  (root/'bin/mint-bridge').write_text(script)
  if mode=='busy-preview':
   body='Service {id:s} Timer {interval:50;running:true;onTriggered:{s.busy=true;s.action="save";s.secret="fixture";var generation=s.generation;s.debugState("ready");s.debugState("off");if(!s.busy || s.demo || s.secret!=="fixture" || s.generation!==generation) Qt.exit(2);else {console.log("PASS");Qt.quit()}}}'
  elif mode=='uncertain-preview':
   body='Service {id:s} Timer {interval:50;running:true;onTriggered:{s.busy=true;s.action="save";s.cancel();s.debugState("ready");s.debugState("off");s.save("test","stub","","");if(!s.saveUncertain || s.demo || s.busy || s.activeRequest) Qt.exit(2);else {console.log("PASS");Qt.quit()}}}'
  elif mode=='demo-cycle':
   body='Service {id:s} Timer {interval:50;running:true;onTriggered:{s.debugState("saving");s.debugState("uncertain");s.debugState("off");if(s.demo || s.busy || s.saveUncertain || s.activeRequest) Qt.exit(2);else {console.log("PASS");Qt.quit()}}}'
  elif mode=='owner':
   body='Service {id:s} Timer {interval:50;running:true;onTriggered:{var a={close:function(){s.closePanel(a)}};var b={close:function(){s.closePanel(b)}};s.busy=true;s.action="save";s.secret="fixture-only";s.openPanel(a);s.openPanel(b);if(!s.busy || s.secret!=="fixture-only" || s.panelOwner!==b) {Qt.exit(2);return} s.closePanel(b);if(s.busy || s.secret || !s.saveUncertain) Qt.exit(2);else {console.log("PASS");Qt.quit()}}}'
  elif mode=='service':
   body='Service {id:s} Component.onCompleted:{s.generate()} Timer {interval:600;running:true;onTriggered:{if(s.health!=="ready" || s.secret!=="fixture-only" || s.presets.length!==2) Qt.exit(2);else {console.log("PASS");Qt.quit()}}}'
  elif mode=='demo':
   body='Service {id:s} Timer {interval:50;running:true;onTriggered:{s.debugState("ready");s.generate();s.copy();s.save("test","stub","","");s.request("vaults");if(s.activeRequest || s.busy) Qt.exit(2);else {console.log("PASS");Qt.quit()}}}'
  else:
   expected='result.ok' if mode=='valid' else '!result.ok'
   callback='' if mode=='cancel' else 'onCompleted:function(result){if('+expected+') {console.log("PASS");Qt.quit()} else Qt.exit(2)}'
   body='Request {id:r;'+callback+'} Component.onCompleted:{r.start({operation:"generate"})}'
   if mode=='cancel':body+=' Timer {interval:100;running:true;onTriggered:r.cancel()} Timer {interval:350;running:true;onTriggered:{if(r.accepting || r.buffer) Qt.exit(2);else {console.log("PASS");Qt.quit()}}}'
  (root/'shell.qml').write_text('import QtQuick\nimport Quickshell\nShellRoot {'+body+' Timer {interval:3000;running:true;onTriggered:Qt.exit(3)} }')
  r=subprocess.run(['/usr/bin/quickshell','-p',str(root/'shell.qml')],env=env,capture_output=True,text=True,timeout=5)
  output=r.stdout+r.stderr
  if r.returncode or 'PASS' not in output or 'TypeError' in output or 'ReferenceError' in output:print(mode,output);raise SystemExit(1)
  print(mode+': PASS')
